# Database. SQLite for local dev/tests; PostgreSQL for anything else (see spec:
# Runtime & stack — SQLite's single-writer lock is not safe once the two-lane
# scheduler is added).
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/automated_swe_jobs
# Used by compose.production.yml to build the internal PostgreSQL URL.
POSTGRES_PASSWORD=

# Web auth. Generate a long random value for production, for example:
#   openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anthropic (LLM ranking, assistant, and structured resume extraction).
ANTHROPIC_API_KEY=

# SignalWire (initial SMS provider).
SIGNALWIRE_SPACE=your-space
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_FROM_NUMBER=+1XXXXXXXXXX

# Telnyx (future primary SMS provider — not yet implemented).
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# Resend (digest email), via their HTTP API.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Scrape / digest tuning.
FAST_LANE_INTERVAL_MINUTES=2
SLOW_LANE_INTERVAL_MINUTES=15
STALE_AFTER_CYCLES=4
DIGEST_MAX_SMS_MATCHES=8
HIGH_PRIORITY_SCORE_THRESHOLD=0.9

# The legacy SMS digest stays at 08:00/20:00. DAILY_EMAIL_HOUR is the default
# for new web profiles; each user can change their own delivery time later.
# All displayed and scheduled delivery times use SCHEDULER_TIMEZONE.
DIGEST_HOURS=8,20
DAILY_EMAIL_HOUR=8
SCHEDULER_TIMEZONE=America/New_York
